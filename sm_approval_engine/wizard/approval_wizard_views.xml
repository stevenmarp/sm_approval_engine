<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- =========================== -->
        <!-- REJECTION WIZARD            -->
        <!-- =========================== -->
        
        <record id="view_sm_approval_reject_wizard_form" model="ir.ui.view">
            <field name="name">sm.approval.reject.wizard.form</field>
            <field name="model">sm.approval.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Request">
                    <group>
                        <field name="request_id" invisible="1"/>
                        <field name="reason" placeholder="Please provide a reason for rejection..."/>
                    </group>
                    <footer>
                        <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sm_approval_reject_wizard" model="ir.actions.act_window">
            <field name="name">Reject Request</field>
            <field name="res_model">sm.approval.reject.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- =========================== -->
        <!-- DELEGATION WIZARD           -->
        <!-- =========================== -->
        
        <record id="view_sm_approval_delegate_wizard_form" model="ir.ui.view">
            <field name="name">sm.approval.delegate.wizard.form</field>
            <field name="model">sm.approval.delegate.wizard</field>
            <field name="arch" type="xml">
                <form string="Delegate Approval">
                    <group>
                        <field name="request_id" invisible="1"/>
                        <field name="delegate_to_id" options="{'no_create': True}"/>
                        <field name="comment" placeholder="Optional comment..."/>
                    </group>
                    <footer>
                        <button name="action_delegate" string="Delegate" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sm_approval_delegate_wizard" model="ir.actions.act_window">
            <field name="name">Delegate Approval</field>
            <field name="res_model">sm.approval.delegate.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
