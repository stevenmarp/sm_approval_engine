<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Escalate Overdue Approval Requests -->
        <record id="ir_cron_escalate_overdue_approvals" model="ir.cron">
            <field name="name">Approval Engine: Escalate Overdue Requests</field>
            <field name="model_id" ref="model_sm_approval_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_escalate_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
